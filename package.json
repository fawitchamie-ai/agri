{
  "name": "agriprevision-togo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-transform-types --test tests/*.test.*",
    "test:integration": "AGRI_TEST_INPROCESS=1 node --experimental-transform-types tests/http-integration.mjs",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "test:regressions": "node --experimental-transform-types tests/final-regressions.mjs",
    "configure:cloudflare": "node scripts/configure-cloudflare.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "smoke:cloudflare": "node scripts/smoke-cloudflare.mjs"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@mapbox/vector-tile": "2.0.4",
    "@types/leaflet": "1.9.20",
    "drizzle-orm": "0.45.2",
    "fzstd": "0.1.1",
    "geotiff": "^3.0.5",
    "jose": "6.2.13",
    "leaflet": "1.9.4",
    "maplibre-gl": "5.6.2",
    "next": "16.3.4",
    "pbf": "4.0.1",
    "polygon-clipping": "^0.15.7",
    "proj4": "^2.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
