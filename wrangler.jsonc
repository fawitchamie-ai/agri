{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agriprevision-togo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agriprevision-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "AUTH_DEMO_ONLY": "false",
    "ADMIN_EMAILS": ""
  },
  "observability": {
    "enabled": false
  }
}
