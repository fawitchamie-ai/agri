# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

!/.env.example
/tmp/
**/__pycache__/

/.cloudflare/
/deploy-backups/

!/.dev.vars.example

# Private database exports and Windows download metadata
/sauvegarde*.sql
/backup*.sql
*:Zone.Identifier
/.ci-python/
/.compute-python/

# Restricted research originals stay local; fetch explicitly under their own licence.
research-data/calibration/raw/research-only/*.xlsx

# Open originals rehydrated by acquire_fertilizer.py with pinned SHA-256.
# Carob is retained; the larger auxiliary workbooks are audit inputs, not Worker assets.
research-data/fertilizer/v1/raw/*.xlsx
research-data/fertilizer/v1/pairs.json
research-data/fertilizer/v1/rejected.json
research-data/fertilizer/v1/test-predictions.json

# Detailed replay outputs are generated locally; publish compact inputs and metrics.
research-data/lirf/*/replay-daily.json.gz
research-data/lirf/*/official-aquacrop-daily.json.gz
research-data/lirf/*/togo-current-rue-daily.json.gz
