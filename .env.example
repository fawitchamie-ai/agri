# Les jetons API ne sont jamais commités. Dans GitHub : Settings > Secrets and variables > Actions.
# Secrets (valeurs à saisir uniquement dans GitHub ou votre terminal sécurisé) :
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
# ADMIN_EMAILS (facultatif, emails autorisés admin dans un JWT Access vérifié)
# CF_ACCESS_CLIENT_ID / CF_ACCESS_CLIENT_SECRET (facultatifs, santé automatisée)
# Variables de dépôt non secrètes :
CLOUDFLARE_DATABASE_ID=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
APP_URL=
CLOUDFLARE_DEPLOY_ENABLED=false
